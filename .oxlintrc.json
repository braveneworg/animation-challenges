{
  "plugins": ["typescript", "react", "jsx-a11y", "import", "promise", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "react/react-in-jsx-scope": "off",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    "jsx-a11y/alt-text": "error",
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }],
    // The repo's throwing type-narrowing assertion helpers (assertSuccess/assertFailure) are the
    // mandated alternative to `if (cond) { expect(...) }` (vitest/no-conditional-expect). Without
    // this, expect-expect flags any test whose only verification is one of these helpers as
    // having no assertions.
    "vitest/expect-expect": [
      "error",
      { "assertFunctionNames": ["expect", "expectTypeOf", "assert", "assertType", "assertSuccess", "assertFailure"] }
    ]
  },
  "ignorePatterns": ["dist", "coverage", "node_modules", "server/db.json"],
  // Scoped to the one fixture that needs it: loop-guard.test.ts runs a `new Function`-compiled
  // string of *already-transpiled, test-authored* code to assert on injected guard calls — never
  // user input, never shipped. Everywhere else in the repo, `typescript/no-implied-eval` still errors.
  "overrides": [
    {
      "files": ["src/runner/loop-guard.test.ts"],
      "rules": {
        "typescript/no-implied-eval": "off"
      }
    },
    {
      // The WAI-ARIA APG Window Splitter pattern requires a FOCUSABLE `role="separator"`
      // (tabIndex + arrow-key handling). Every tag/role combination tried against this repo's real
      // config (oxlint 1.77.0, --type-aware) trips a different jsx-a11y rule — evidence, not
      // assumption, from actually running `pnpm lint` against each form in PaneSplitter.tsx:
      //   - `<div role="separator" tabIndex={0} onKeyDown/onPointerDown/Move/Up>` (shipped): trips
      //     ONLY `prefer-tag-over-role` (1 rule).
      //   - `<hr role="separator" ...same attrs/handlers>`: trips `no-noninteractive-element-to-
      //     interactive-role` (adding an interactive role to a non-interactive element) AND
      //     `no-redundant-roles` (the same role is simultaneously flagged as redundant with hr's
      //     own implicit role) — 2 rules, mutually contradictory on their own terms.
      //   - bare `<hr ...same attrs/handlers, no role>` (relying on hr's implicit separator role):
      //     trips `no-noninteractive-tabindex` and `no-noninteractive-element-interactions` (hr is
      //     a non-interactive element) — 2 rules.
      // No combination reaches zero; the div form is the minimal-footprint one, so
      // `prefer-tag-over-role` alone is scoped off for this file. `no-noninteractive-tabindex`,
      // `no-noninteractive-element-interactions`, `no-noninteractive-element-to-interactive-role`,
      // and `no-redundant-roles` all stay on everywhere, including here — none of them fire against
      // the shipped div form.
      "files": ["src/features/workspace/PaneSplitter.tsx"],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    }
  ]
}
